                    <TextBlock Style="{StaticResource H1}" Text="Розкладка"/>
                    <TextBlock Style="{StaticResource Lead}" Text="Ручне виправлення і поля, де англійська потрібна завжди."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Хоткей ручного виправлення" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource RowDesc}" Margin="0,0,0,14" Text="Переписує останнє слово в полі в іншій розкладці — там, де автоматика промовчала."/>
