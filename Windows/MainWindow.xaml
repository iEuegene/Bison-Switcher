                                <Border Background="#0B2A20" BorderBrush="#2E5E4C" BorderThickness="1" CornerRadius="12" Padding="14,8">
                                    <TextBlock x:Name="HotkeyText" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="13" Foreground="#F0FC7E"/>
