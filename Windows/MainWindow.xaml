                            <TextBlock Style="{StaticResource H2}" Text="Слова поза словником"/>
                            <TextBlock Style="{StaticResource RowDesc}" Margin="0,0,0,14"
                                       Text="Слова зі словника (≈280 тис. форм UA, ≈190 тис. EN) виправляються однаково на будь-якому рівні. Рівень впливає лише на рідкісні слова, яких словник не знає."/>
                            <WrapPanel>
                                <RadioButton x:Name="SensCareful" Style="{StaticResource Chip}" GroupName="sens" Content="Обережно" Tag="0" Checked="Sens_Checked"/>
                                <RadioButton x:Name="SensNormal" Style="{StaticResource Chip}" GroupName="sens" Content="Звичайно" Tag="1" Checked="Sens_Checked"/>
                                <RadioButton x:Name="SensBold" Style="{StaticResource Chip}" GroupName="sens" Content="Сміливо" Tag="2" Checked="Sens_Checked"/>
