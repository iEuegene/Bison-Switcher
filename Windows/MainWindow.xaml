                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Style="{StaticResource H2}" Text="Розкладка для чату Teams" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Відкрийте чат у Teams, потім натисніть кнопку — розкладка вмикатиметься для цього співрозмовника."/>
