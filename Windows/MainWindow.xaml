                            <TextBlock Style="{StaticResource RowDesc}" Margin="0,6,0,14" Foreground="{StaticResource LimeBrush}"
                                       Text="Приклад: ваш логін «vfrcbv» перетворюється на «максим». Додайте vfrcbv."/>
