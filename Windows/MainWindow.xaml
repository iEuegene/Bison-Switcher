<Window x:Class="Kright.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bison Switcher" Width="460" Height="640"
        Background="#0D0D0D" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DDDDDD"/></Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Background="#0D0D0D" BorderThickness="0">

        <!-- DETECT (developer tool — hidden unless Debug mode is on) -->
        <TabItem x:Name="DetectTab" Header="Detect">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                <StackPanel>
                    <TextBlock Text="FOCUSED FIELD" FontWeight="Bold" FontSize="11" Foreground="#777"/>
                    <TextBlock x:Name="AppLabel" Margin="0,4,0,10" Foreground="#999"/>

                    <Border Background="#161616" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="WRONG-LAYOUT FIX" FontWeight="Bold" FontSize="11" Foreground="#888"/>
                            <TextBlock x:Name="TypedText" Margin="0,6,0,0" Foreground="#CCC"/>
                            <TextBlock x:Name="ConvertedText" Margin="0,4,0,0" FontSize="18"
                                       FontWeight="Bold" Foreground="#FFD166"/>
                            <TextBlock x:Name="GibberishText" Margin="0,4,0,0" FontSize="11"/>
                            <Button x:Name="ReplaceButton" Content="Replace in field" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Click="ReplaceButton_Click"/>
                            <TextBlock x:Name="ReplaceResult" Margin="0,6,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="LANGUAGES" FontWeight="Bold" FontSize="11" Foreground="#777"/>
                    <TextBlock x:Name="LanguagesText" Margin="0,4,0,0" Foreground="#CCC"/>

                    <TextBlock Text="LAYOUT MAP" FontWeight="Bold" FontSize="11" Foreground="#777" Margin="0,12,0,0"/>
                    <TextBlock x:Name="LayoutMapText" FontFamily="Consolas" FontSize="10"
                               Foreground="#AAA" Margin="0,4,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="DETECTED TYPE" FontWeight="Bold" FontSize="11" Foreground="#777" Margin="0,12,0,0"/>
                    <TextBlock x:Name="GuessText" Margin="0,4,0,0" FontSize="15" FontWeight="Bold" Foreground="#88CC88"/>

                    <TextBlock Text="AUTO-FIX — LAST WORD" FontWeight="Bold" FontSize="11" Foreground="#777" Margin="0,12,0,0"/>
                    <TextBlock x:Name="AutoFixDecisionText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12"
                               Foreground="#CCC" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- SETTINGS -->
        <!-- SETTINGS -->
        <TabItem Header="Налаштування">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">

                <!-- ===== AUTO-FIX ===== -->
                <TextBlock Text="Автовиправлення розкладки" FontWeight="SemiBold"/>
                <CheckBox x:Name="AutoFixCheck" Margin="0,6,0,0" Foreground="#CCC"
                          Click="AutoFixCheck_Click">
                    <TextBlock Text="Виправляти слова, набрані не в тій розкладці (на пробілі, Tab, Enter)" TextWrapping="Wrap" Foreground="#CCC"/>
                </CheckBox>
                <CheckBox x:Name="UndoCheck" Margin="0,4,0,0" Foreground="#CCC"
                          Click="UndoCheck_Click">
                    <TextBlock Text="Backspace одразу після заміни — повернути як було" TextWrapping="Wrap" Foreground="#CCC"/>
                </CheckBox>
                <CheckBox x:Name="LearnCheck" Margin="0,4,0,0" Foreground="#CCC"
                          Click="LearnCheck_Click">
                    <TextBlock Text="Вчитися: скасоване → «не чіпати», двічі виправлене хоткеєм → «завжди»" TextWrapping="Wrap" Foreground="#CCC"/>
                </CheckBox>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Незнайомі слова:" Foreground="#AAA" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="SensitivityCombo" Width="200" FontSize="11"
                              SelectionChanged="SensitivityCombo_SelectionChanged">
                        <ComboBoxItem Content="Обережно — майже не чіпати"/>
                        <ComboBoxItem Content="Звичайно"/>
                        <ComboBoxItem Content="Сміливо — більше виправлень"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock Foreground="#666" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Слова зі словника (≈280 тис. форм UA, ≈190 тис. EN) виправляються однаково на будь-якому рівні; рівень впливає лише на слова поза словником."/>

                <Separator Margin="0,12"/>

                <TextBlock Text="Програми-виключення" FontWeight="SemiBold"/>
                <TextBlock Foreground="#666" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Тут автовиправлення вимкнене. Хоткей працює й тут."/>
                <StackPanel x:Name="ExcludedPanel" Margin="0,6,0,0"/>
                <Button x:Name="ExcludeAppButton" Content="+ Виключити поточну програму"
                        FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Click="ExcludeAppButton_Click"/>
                <TextBlock x:Name="ExcludeStatus" FontSize="10" Foreground="#888"
                           Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                <Separator Margin="0,12"/>

                <TextBlock Text="Мій словник" FontWeight="SemiBold"/>
                <TextBlock Text="Ніколи не виправляти (як набрано: сленг, назви, логіни)"
                           Foreground="#AAA" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox x:Name="NeverBox" Width="200" FontSize="11" KeyDown="NeverBox_KeyDown"/>
                    <Button Content="Додати" FontSize="11" Margin="6,0,0,0" Click="AddNever_Click"/>
                </StackPanel>
                <WrapPanel x:Name="NeverPanel" Margin="0,6,0,0"/>

                <TextBlock Text="Завжди виправляти на (як має бути: терміни, імена)"
                           Foreground="#AAA" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox x:Name="AlwaysBox" Width="200" FontSize="11" KeyDown="AlwaysBox_KeyDown"/>
                    <Button Content="Додати" FontSize="11" Margin="6,0,0,0" Click="AddAlways_Click"/>
                </StackPanel>
                <WrapPanel x:Name="AlwaysPanel" Margin="0,6,0,0"/>

                <Separator Margin="0,12"/>

                <TextBlock Text="Хоткей ручного виправлення" FontWeight="SemiBold"/>
                <TextBlock Text="Виправляє останнє слово у полі — там, де автоматика промовчала."
                           Foreground="#888" FontSize="11" Margin="0,2,0,6" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#1F1F1F" CornerRadius="6" Padding="10,5">
                        <TextBlock x:Name="HotkeyText" FontFamily="Consolas" Foreground="White"/>
                    </Border>
                    <Button x:Name="RecordButton" Content="Змінити…" Margin="8,0,0,0" Click="RecordButton_Click"/>
                </StackPanel>

                <Separator Margin="0,12"/>

                <TextBlock Text="Англійська автоматично" FontWeight="SemiBold"/>
                <CheckBox x:Name="AutoLangCheck" Margin="0,6,0,0" Foreground="#CCC"
                          Click="AutoLangCheck_Click">
                    <TextBlock Text="У полях email / URL / пароль" TextWrapping="Wrap" Foreground="#CCC"/>
                </CheckBox>
                <CheckBox x:Name="AddressBarCheck" Margin="0,4,0,0" Foreground="#CCC"
                          Click="AddressBarCheck_Click">
                    <TextBlock Text="В адресному рядку браузера (Chrome, Edge, Brave, Opera, Vivaldi, Firefox)" TextWrapping="Wrap" Foreground="#CCC"/>
                </CheckBox>
                <TextBlock x:Name="AutoLangStatus" Foreground="#88CC88" FontSize="11" Margin="0,4,0,0"/>

                <Separator Margin="0,12"/>

                <TextBlock Text="Розкладка для програми" FontWeight="SemiBold"/>
                <CheckBox x:Name="AppLangCheck" Margin="0,6,0,0" Foreground="#CCC"
                          Click="AppLangCheck_Click">
                    <TextBlock Text="Перемикати розкладку, коли програма отримує фокус" TextWrapping="Wrap" Foreground="#CCC"/>
                </CheckBox>
                <StackPanel x:Name="RulesPanel" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox x:Name="AddLayoutCombo" Width="80" Margin="0,0,8,0" FontSize="11"/>
                    <Button x:Name="AddAppButton" Content="+ Додати поточну програму"
                            FontSize="11" Click="AddAppButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="AddAppStatus" FontSize="10" Foreground="#888"
                           Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                <Separator Margin="0,12"/>

                <TextBlock Text="Розкладка для чату Teams" FontWeight="SemiBold"/>
                <CheckBox x:Name="ContactLangCheck" Margin="0,6,0,0" Foreground="#CCC"
                          Click="ContactLangCheck_Click">
                    <TextBlock Text="Перемикати розкладку для окремих чатів Teams" TextWrapping="Wrap" Foreground="#CCC"/>
                </CheckBox>
                <StackPanel x:Name="ContactRulesPanel" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox x:Name="ContactLayoutCombo" Width="80" Margin="0,0,8,0" FontSize="11"/>
                    <Button x:Name="AddContactButton" Content="+ Додати поточний чат Teams"
                            FontSize="11" Click="AddContactButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="AddContactStatus" FontSize="10" Foreground="#888"
                           Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                <Separator Margin="0,12"/>

                <TextBlock Text="Запуск" FontWeight="SemiBold"/>
                <CheckBox x:Name="StartupCheck" Margin="0,6,0,0" Foreground="#CCC" Click="StartupCheck_Click">
                    <TextBlock Text="Запускати разом з Windows" TextWrapping="Wrap" Foreground="#CCC"/>
                </CheckBox>

                <Separator Margin="0,12"/>

                <TextBlock Text="Для розробника" FontWeight="SemiBold"/>
                <CheckBox x:Name="DebugCheck" Margin="0,6,0,0" Foreground="#CCC" Click="DebugCheck_Click">
                    <TextBlock Text="Debug — показати вкладку Detect" TextWrapping="Wrap" Foreground="#CCC"/>
                </CheckBox>

                <Separator Margin="0,12"/>

                <TextBlock Text="Приватність" FontWeight="SemiBold"/>
                <TextBlock Foreground="#8BBE8B" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="• Без мережі: жодних запитів в інтернет, оновлення вимкнені."/>
                <TextBlock Foreground="#8BBE8B" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="• Без журналу: у пам'яті лише поточне слово, на диск нічого не пишеться."/>
                <TextBlock Foreground="#8BBE8B" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="• Поля паролів: перехоплення вимикається, поки курсор у такому полі."/>

                <Separator Margin="0,12"/>

                <TextBlock x:Name="VersionText" Foreground="#CCC"/>
                <TextBlock Margin="0,4,0,0" FontSize="11">
                    <Hyperlink NavigateUri="https://github.com/iEuegene/Bison-Switcher"
                               RequestNavigate="Hyperlink_RequestNavigate">Bison Switcher на GitHub</Hyperlink>
                    <Run Text="   ·   на основі " Foreground="#888"/>
                    <Hyperlink NavigateUri="https://github.com/walteryaron/Kright"
                               RequestNavigate="Hyperlink_RequestNavigate">Kright</Hyperlink>
                    <Run Text=" (Yaron Walter, MIT)" Foreground="#888"/>
                </TextBlock>

                <Separator Margin="0,12"/>

                <Button Content="Вийти з Bison Switcher" HorizontalAlignment="Left" Click="Quit_Click"/>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
