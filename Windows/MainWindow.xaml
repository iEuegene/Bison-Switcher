                                </StackPanel>
                                <CheckBox x:Name="DebugCheck" Grid.Column="1" Style="{StaticResource Toggle}" Click="DebugCheck_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Оновлення" Margin="0,0,0,4"/>
                            <TextBlock x:Name="UpdateCurrentText" Style="{StaticResource RowDesc}" Margin="0,0,0,14"/>
