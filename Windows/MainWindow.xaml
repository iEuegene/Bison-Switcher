                                <Button x:Name="InstallUpdateButton" Style="{StaticResource Primary}" Content="Скачати та встановити" Click="InstallUpdate_Click"/>
                            </WrapPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Перевіряти автоматично"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Раз на день програма дивиться, чи є нова версія на GitHub, і повідомляє в треї. Нічого, крім цього запиту, в інтернет не надсилається."/>
                                </StackPanel>
                                <CheckBox x:Name="AutoUpdateCheck" Grid.Column="1" Style="{StaticResource Toggle}" Click="AutoUpdateCheck_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Приватність"/>
