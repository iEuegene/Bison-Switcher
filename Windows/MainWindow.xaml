                            <TextBlock Style="{StaticResource RowDesc}" Margin="0,6,0,14" Foreground="{StaticResource LimeBrush}"
                                       Text="Приклад: «інвеб» на англійській розкладці виходить «sydt,», і програма його не чіпає. Додайте інвеб — і «sydt,» стане «інвеб»."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AlwaysBox" KeyDown="AlwaysBox_KeyDown"/>
                                <Button Grid.Column="1" Style="{StaticResource Primary}" Content="Додати" Margin="10,0,0,0" Click="AddAlways_Click"/>
                            </Grid>
                            <WrapPanel x:Name="AlwaysPanel" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== APPS ===== -->
