                                <Run Text=" (Yaron Walter, MIT) · шрифти Geist та Unbounded (OFL)"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== DIAGNOSTICS (Debug) ===== -->
            <ScrollViewer x:Name="PageDetect" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="40,34,40,30" MaxWidth="820">
                    <TextBlock Style="{StaticResource H1}" Text="Діагностика"/>
                    <TextBlock Style="{StaticResource Lead}" Text="Тут видно, чому програма виправила слово або залишила його як є. Корисно, коли заміна спрацювала не там або не спрацювала там, де мала."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="Останнє набране слово"/>
                            <TextBlock x:Name="DiagWord" Margin="0,10,0,0" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="18" TextWrapping="Wrap" Text="—"/>
                            <TextBlock x:Name="DiagVerdict" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DiagReason" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AutoFixDecisionText" Margin="0,12,0,0" FontSize="11" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="Поле, у якому ви друкуєте"/>
                            <TextBlock Style="{StaticResource RowDesc}" Margin="0,4,0,8" Text="Залиште це вікно відкритим поруч і клацніть у поле іншої програми — тут з'явиться його тип. У полях пароля автовиправлення вимикається."/>
                            <TextBlock x:Name="AppLabel" Margin="0,6,0,0"/>
                            <TextBlock x:Name="GuessText" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="#F0FC7E"/>
                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock x:Name="TypedText" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="ConvertedText" Margin="0,6,0,0" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="20" Foreground="#F0FC7E"/>
                            <TextBlock x:Name="GibberishText" Margin="0,6,0,0" FontSize="12"/>
                            <Button x:Name="ReplaceButton" Style="{StaticResource Ghost}" Content="Замінити в полі" Margin="0,12,0,0" Click="ReplaceButton_Click"/>
                            <TextBlock x:Name="ReplaceResult" Margin="0,6,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="Розкладки"/>
                            <TextBlock x:Name="LanguagesText" Margin="0,6,0,0"/>
                            <TextBlock x:Name="LayoutMapText" Margin="0,12,0,0" FontFamily="Consolas" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
