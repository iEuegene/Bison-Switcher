                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Адресний рядок браузера"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Chrome, Edge, Brave, Opera, Vivaldi, Firefox. Український запит, набраний латиницею, виправиться сам."/>
                                </StackPanel>
                                <CheckBox x:Name="AddressBarCheck" Grid.Column="1" Style="{StaticResource Toggle}" Click="AddressBarCheck_Click"/>
                            </Grid>
                            <TextBlock x:Name="AutoLangStatus" Style="{StaticResource Status}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== SYSTEM ===== -->
            <ScrollViewer x:Name="PageSystem" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="40,34,40,30" MaxWidth="820">
                    <TextBlock Style="{StaticResource H1}" Text="Система"/>
                    <TextBlock Style="{StaticResource Lead}" Text="Запуск, приватність і службове."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Запускати разом з Windows"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="Bison Switcher стартує у треї після входу в систему."/>
                                </StackPanel>
                                <CheckBox x:Name="StartupCheck" Grid.Column="1" Style="{StaticResource Toggle}" Click="StartupCheck_Click"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
