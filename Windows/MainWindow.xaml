<Window x:Class="Kright.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bison Switcher" Width="1020" Height="680" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#071F17" Foreground="#F7F7F7" FontSize="13"
        FontFamily="pack://application:,,,/Fonts/#Geist"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- Inweb palette: green #003B29, lime #F0FC7E, orange #EF583D, #1C1C1C, #F7F7F7.
         Fonts: Geist (text), Unbounded (headlines, big numbers). -->
    <Window.Resources>
        <FontFamily x:Key="Display">pack://application:,,,/Fonts/#Unbounded</FontFamily>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="BgBrush" Color="#071F17"/>
        <SolidColorBrush x:Key="SideBrush" Color="#0A271D"/>
        <SolidColorBrush x:Key="CardBrush" Color="#0E3125"/>
        <SolidColorBrush x:Key="CardHiBrush" Color="#133B2D"/>
        <SolidColorBrush x:Key="LineBrush" Color="#1F4A3B"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94ADA3"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#5E7D71"/>
        <SolidColorBrush x:Key="LimeBrush" Color="#F0FC7E"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#EF583D"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#003B29"/>
        <SolidColorBrush x:Key="DarkBrush" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="PaperBrush" Color="#F7F7F7"/>

        <!-- Text roles -->
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="28"/>
        </Style>
        <Style x:Key="Lead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,24"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Card titles sit beside the skewed tile, never under it -->
        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource CardLabel}">
            <Setter Property="Margin" Value="0,0,72,0"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="Status" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LimeBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Surfaces -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource LineBrush}"/>
            <Setter Property="Margin" Value="0,16"/>
        </Style>
        <!-- Brand stroke: the skewed parallelogram from the Inweb symbols -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Width" Value="62"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,-6,-2,0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <SkewTransform AngleX="-14"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <SkewTransform AngleX="14"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar navigation -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="14" Padding="6,7,12,7" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="mark" Data="M2,0 L6,0 L4,20 L0,20 Z" Fill="#F0FC7E"
                                      VerticalAlignment="Center" Visibility="Hidden"/>
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10"
                                        Background="{TemplateBinding Background}">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" Foreground="{TemplateBinding BorderBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0F3226"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#133B2D"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#24533F"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle switch -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26" Background="Transparent">
                            <Border x:Name="track" CornerRadius="13" Background="#16392C"
                                    BorderBrush="#2E5E4C" BorderThickness="1"/>
                            <Ellipse x:Name="knob" Width="18" Height="18" Fill="#94ADA3"
                                     HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#F0FC7E"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#F0FC7E"/>
                                <Setter TargetName="knob" Property="Fill" Value="#003B29"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#003B29"/>
            <Setter Property="Background" Value="#F0FC7E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Foreground" Value="#F7F7F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2E5E4C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#5E7D71"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EF583D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chips: segmented choices (sensitivity, keyboard layout) -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F7F7F7"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="10" Padding="12,6" Background="#0B2A20"
                                BorderBrush="#2E5E4C" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#94ADA3"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F0FC7E"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#F0FC7E"/>
                                <Setter Property="Foreground" Value="#003B29"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F7F7F7"/>
            <Setter Property="CaretBrush" Value="#F0FC7E"/>
            <Setter Property="SelectionBrush" Value="#F0FC7E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="12" Background="#0B2A20" BorderBrush="#2E5E4C"
                                BorderThickness="1" Padding="10,7">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#F0FC7E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2C5546" CornerRadius="4" Margin="3,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22,16,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Grid Width="44" Height="34">
                        <Path Data="M10,0 L44,0 L34,34 L0,34 Z" Fill="#F0FC7E"/>
                        <TextBlock Text="BS" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="13"
                                   Foreground="#003B29" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="{StaticResource Display}"
                               FontWeight="Bold" FontSize="14">
                        <Run Text="bison"/><Run Text="." Foreground="#F0FC7E"/><Run Text="switcher"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#0E3125" CornerRadius="14" Padding="12,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Автовиправлення" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SideState" Text="Увімкнено" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="SideToggle" Grid.Column="1" Style="{StaticResource Toggle}" Click="SideToggle_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" Content="Огляд" Tag="&#xE80F;"
                                 Background="#F0FC7E" BorderBrush="#003B29" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAutoFix" Style="{StaticResource NavItem}" Content="Автовиправлення" Tag="&#xE945;"
                                 Background="#EF583D" BorderBrush="#F7F7F7" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDict" Style="{StaticResource NavItem}" Content="Словник" Tag="&#xE82D;"
                                 Background="#F7F7F7" BorderBrush="#003B29" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Content="Програми" Tag="&#xE71D;"
                                 Background="#1F5C46" BorderBrush="#F0FC7E" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLayout" Style="{StaticResource NavItem}" Content="Розкладка" Tag="&#xE765;"
                                 Background="#F0FC7E" BorderBrush="#003B29" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" Content="Система" Tag="&#xE713;"
                                 Background="#1C1C1C" BorderBrush="#F7F7F7" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDetect" Style="{StaticResource NavItem}" Content="Діагностика" Tag="&#xEBE8;"
                                 Background="#3A2A24" BorderBrush="#EF583D" Checked="Nav_Checked" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= PAGES ================= -->
        <Grid Grid.Column="1">

            <!-- ===== OVERVIEW ===== -->
            <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40,34,40,30" MaxWidth="900">
                    <TextBlock x:Name="OvHeadline" Style="{StaticResource H1}" Text="Розкладка під контролем."/>
                    <TextBlock x:Name="OvSub" Style="{StaticResource Lead}" Text="Пишіть як звикли — промахи розкладки виправляються на пробілі."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Border Style="{StaticResource Tile}" Background="#F0FC7E">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE945;" Foreground="#003B29"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileLabel}" Text="Автовиправлення"/>
                                    <TextBlock x:Name="OvAutoState" Style="{StaticResource Big}" Text="Увімк." Margin="0,10,0,4"/>
                                    <TextBlock x:Name="OvAutoSub" Foreground="{StaticResource MutedBrush}" Text="на пробілі, Tab, Enter" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="OvToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Left"
                                              Margin="0,16,0,0" Click="OvToggle_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <Border Style="{StaticResource Tile}" Background="#EF583D">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE8FB;" Foreground="#F7F7F7"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileLabel}" Text="Виправлено"/>
                                    <TextBlock x:Name="OvFixed" Style="{StaticResource Big}" Text="0" Margin="0,10,0,4"/>
                                    <TextBlock x:Name="OvFixedSub" Foreground="{StaticResource MutedBrush}" Text="слів за цей запуск" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="OvLastLabel" Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="0,16,0,2"
                                               Text="Останнє виправлення" Visibility="Collapsed"/>
                                    <TextBlock x:Name="OvLast" Foreground="{StaticResource LimeBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource Card}">
                            <Grid>
                                <Border Style="{StaticResource Tile}" Background="#F7F7F7">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE82D;" Foreground="#003B29"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileLabel}" Text="Словники"/>
                                    <TextBlock x:Name="OvDict" Style="{StaticResource Big}" Text="—" Margin="0,10,0,4"/>
                                    <TextBlock x:Name="OvDictSub" Foreground="{StaticResource MutedBrush}" Text="словоформ UA + EN" TextWrapping="Wrap"/>
                                    <TextBlock Foreground="{StaticResource LimeBrush}" FontSize="12" Margin="0,16,0,0" Text="✓ Працюють офлайн"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Border Style="{StaticResource Tile}" Background="#1F5C46">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE71D;" Foreground="#F0FC7E"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileLabel}" Text="Програми-виключення"/>
                                    <TextBlock x:Name="OvExcluded" Style="{StaticResource Big}" Text="0" Margin="0,10,0,4"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="там автовиправлення не втручається" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource Ghost}" Content="Керувати" Margin="0,16,0,0" Tag="apps" Click="GoTo_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <Border Style="{StaticResource Tile}" Background="#1C1C1C">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE70F;" Foreground="#F7F7F7"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileLabel}" Text="Мій словник"/>
                                    <TextBlock x:Name="OvWords" Style="{StaticResource Big}" Text="0" Margin="0,10,0,4"/>
                                    <TextBlock x:Name="OvWordsSub" Foreground="{StaticResource MutedBrush}" Text="не виправляти · нових слів" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource Ghost}" Content="Відкрити" Margin="0,16,0,0" Tag="dict" Click="GoTo_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== AUTO-FIX ===== -->
            <ScrollViewer x:Name="PageAutoFix" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="40,34,40,30" MaxWidth="820">
                    <TextBlock Style="{StaticResource H1}" Text="Автовиправлення"/>
                    <TextBlock Style="{StaticResource Lead}" Text="Слово, набране не в тій розкладці, замінюється на пробілі, Tab або Enter, а розкладка перемикається."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Виправляти автоматично"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="ghbdsn → привіт, руддщ → hello. Хоткей ручного виправлення працює завжди."/>
                                </StackPanel>
                                <CheckBox x:Name="AutoFixCheck" Grid.Column="1" Style="{StaticResource Toggle}" Click="AutoFixCheck_Click"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Велика літера на початку речення"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Text="«Привіт. мене звати…» → «Привіт. Мене звати…». Працює після . ! ? і пробілу; скорочення на кшталт «грн.», «т. д.», «e.g.» і три крапки не враховуються. Потрібна мала літера — зітріть велику Backspace і наберіть знову."/>
                                </StackPanel>
                                <CheckBox x:Name="CapitalizeCheck" Grid.Column="1" Style="{StaticResource Toggle}" Click="CapitalizeCheck_Click"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid>
